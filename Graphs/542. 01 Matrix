#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {
        int n = mat.size();
        int m = mat[0].size();

        queue<pair<pair<int, int>, int>> q; // {{r, c}, step}
        int visited[n][m];
        vector<vector<int>> dist(n, vector<int>(m, 0));
        for(int i = 0; i < n ; i++){
            for(int j = 0; j < m ; j++){
                if(mat[i][j] == 0) {
                    q.push({{i, j}, 0});
                    visited[i][j] = 1;
                }
                else visited[i][j] = 0;
            }
        }

        int delRow[] = {-1, 1, 0, 0};
        int delCol[] = {0, 0, -1, 1};
        while(!q.empty()){
            int r = q.front().first.first;
            int c = q.front().first.second;
            int t = q.front().second;
            dist[r][c] = t;
            q.pop();

            for(int i = 0 ; i < 4 ; i++){
                int newRow = r + delRow[i];
                int newCol = c + delCol[i];

                if(newRow >= 0 && newRow < n &&
                newCol >= 0 && newCol < m &&
                mat[newRow][newCol] == 1 && !visited[newRow][newCol]){
                        q.push({{newRow, newCol}, t + 1});
                        visited[newRow][newCol] = 1;
                }
            }   
        }
        return dist;
    }
};