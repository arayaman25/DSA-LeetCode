#include <iostream>
#include <vector>
using namespace std;
class Solution {
public:
    string evaluate(string s, vector<vector<string>>& knowledge) {
        unordered_map<string, string> mp;

        for(auto &it : knowledge) {
            mp[it[0]] = it[1];
        }

        string res = "";
        for(int i = 0; i < s.size(); i++) {
            if(s[i] == '(') {
                string key = "";
                i++;
                while(s[i] != ')') {
                    key += s[i];
                    i++;
                }
                if(mp.count(key)) res += mp[key];
                else res += "?";
            }
            else res += s[i];
        }
        return res;
    }
};